project         = "project"

environment     = "dev"
aws_region      = "eu-west-1"   # aws_region 값에 따라 `locals.tf` 내에서 변수 `region_name`, `region_code` 값을 자동으로 매핑한다.

# aws_account_id  = ""

# ============================================================
# MGMT
# ============================================================
# VPC
mgmt_vpc_cidr        = "10.0.0.0/16"

mgmt_public_subnet_cidrs = {
    a = "10.0.1.0/24"
    b = "10.0.2.0/24"
}

# ============================================================
# SVC
# ============================================================
# VPC
svc_vpc_cidr        = "10.10.0.0/16"

svc_private_subnet_cidrs = {
    a = "10.10.1.0/24"
    b = "10.10.2.0/24"
}

# ============================================================
# DB
# ============================================================
# VPC
db_vpc_cidr        = "10.20.0.0/16"

db_private_subnet_cidrs = {
    a = "10.20.1.0/25"
    b = "10.20.1.128/25"
}

# ============================================================
# S3
# ============================================================
s3_bucket = [
  "my-app-bucket",
  "my-app-bucket/*"
]

# ============================================================
# ECR Repository
# ============================================================
ecr_repositories = [
  "my-app1",
  "my-app2"
]